[global]
log_level = "info"
metrics_listen = "127.0.0.1:9090"
# metrics_bearer_token = "replace-with-secret"
# metrics_tls_cert = "/etc/portrelay/metrics-cert.pem"
# metrics_tls_key = "/etc/portrelay/metrics-key.pem"
connect_timeout = "10s"
shutdown_timeout = "30s"
max_connections = 100000
max_connecting = 10000
forward_mode = "auto"
buffer_size = 16384
buffer_pool_size = 8
connection_log_sample_rate = 1000

[[relay]]
name = "mariadb"
listen = "0.0.0.0:13306"
target = "mariadb.internal:3306"
max_connections = 50000
idle_timeout = "30m"

[[relay]]
name = "ssh"
listen = "0.0.0.0:10022"
target = "linux01.internal:22"

[[relay]]
name = "mongodb"
listen = "0.0.0.0:27018"
target = "mongo01.internal:27017"
max_connections = 50000
